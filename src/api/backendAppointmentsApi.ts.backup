const BASE_URL = (
  import.meta.env.VITE_API_BASE_URL ??
  "http://localhost:5187"
).replace(/\/$/, "");

export type BackendAppointmentRecord =
  Record<string, unknown>;

export async function getBackendAppointments():
  Promise<BackendAppointmentRecord[]> {

  const response = await fetch(
    `${BASE_URL}/api/Appointments`,
    {
      headers: {
        Accept: "application/json",
      },
    }
  );

  if (!response.ok) {
    throw new Error(
      `Randevular okunamadı: HTTP ${response.status}`
    );
  }

  const data: unknown = await response.json();

  if (!Array.isArray(data)) {
    throw new Error("Beklenen randevu listesi alınamadı.");
  }

  return data as BackendAppointmentRecord[];
}