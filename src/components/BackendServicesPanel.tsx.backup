import { useEffect, useState } from "react";
import type { FormEvent } from "react";
import type { SectorId } from "../data/sectors";

import {
  getBackendServices,
  createBackendService,
  updateBackendService,
  deleteBackendService,
  type BackendService,
} from "../api/backendServicesApi";

import {
  normalizeSector,
  toBackendSector,
} from "../utils/sectorMapping";
import {
  BriefcaseBusiness,
  Clock3,
  Pencil,
  Trash2,
} from "lucide-react";

type Props = {
  sectorId: SectorId;
};

export default function BackendServicesPanel({
  sectorId,
}: Props) {
  const [services, setServices] = useState<BackendService[]>([]);
  const [editing, setEditing] = useState<BackendService | null>(null);

  const [name, setName] = useState("");
  const [duration, setDuration] = useState(30);
  const [price, setPrice] = useState(0);

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [message, setMessage] = useState("");

  async function refresh() {
    const result = await getBackendServices();
    setServices(result);
  }

  useEffect(() => {
    let alive = true;

    getBackendServices()
      .then((data) => {
        if (alive) {
          setServices(data);
          setError("");
        }
      })
      .catch((err: unknown) => {
        if (alive) {
          setError(
            err instanceof Error ? err.message : "Bağlantı hatası"
          );
        }
      })
      .finally(() => {
        if (alive) setLoading(false);
      });

    return () => {
      alive = false;
    };
  }, []);

  function resetForm() {
    setEditing(null);
    setName("");
    setDuration(30);
    setPrice(0);
  }

  function startEdit(item: BackendService) {
    setEditing(item);
    setName(item.name);
    setDuration(item.durationMinutes);
    setPrice(item.price);
    setError("");
    setMessage("");
  }

  async function save(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    if (saving) return;

    if (
      !name.trim() ||
      !Number.isInteger(duration) ||
      duration < 1 ||
      duration > 100000 ||
      !Number.isFinite(price) ||
      price < 0
    ) {
      setError("Hizmet bilgilerini kontrol edin.");
      return;
    }

    setSaving(true);
    setError("");
    setMessage("");

    try {
      if (editing) {
        await updateBackendService(editing.id, {
          name: name.trim(),
          sector: editing.sector,
          description: editing.description,
          durationMinutes: duration,
          price,
        });
      } else {
        await createBackendService({
          name: name.trim(),
          sector: toBackendSector(sectorId),
          description: null,
          durationMinutes: duration,
          price,
        });
      }

      await refresh();

      setMessage(
        editing
          ? "Hizmet PostgreSQL'de güncellendi."
          : "Yeni hizmet PostgreSQL'e kaydedildi."
      );

      resetForm();
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Kayıt başarısız."
      );
    } finally {
      setSaving(false);
    }
  }

  async function remove(item: BackendService) {
    if (
      !window.confirm(
        `"${item.name}" hizmetini kalıcı olarak silmek istiyor musunuz?`
      )
    ) {
      return;
    }

    setSaving(true);
    setError("");
    setMessage("");

    try {
      await deleteBackendService(item.id);
      await refresh();

      if (editing?.id === item.id) {
        resetForm();
      }

      setMessage("Hizmet veritabanından silindi.");
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Hizmet silinemedi."
      );
    } finally {
      setSaving(false);
    }
  }

  const filtered = services.filter(
    (item) => normalizeSector(item.sector) === sectorId
  );

  return (
    <section className="space-y-5 rounded-2xl border border-cyan-500/30 bg-[#101d30] p-6 text-white">
      <div>
        <h2 className="text-xl font-bold">
          Gerçek Hizmet Yönetimi
        </h2>
        <p className="mt-1 text-sm text-slate-400">
          ASP.NET Core API / PostgreSQL
        </p>
      </div>

      <form
        onSubmit={save}
        className="grid gap-3 md:grid-cols-4"
      >
        <input
          value={name}
          onChange={(event) => setName(event.target.value)}
          placeholder="Hizmet adı"
          maxLength={150}
          required
          className="rounded-xl border border-slate-600 bg-[#091322] p-3"
        />

        <input
          type="number"
          min={1}
          max={100000}
          value={duration}
          onChange={(event) =>
            setDuration(event.target.valueAsNumber)
          }
          required
          aria-label="Hizmet süresi (dakika)"
          className="rounded-xl border border-slate-600 bg-[#091322] p-3"
        />

        <input
          type="number"
          min={0}
          step="0.01"
          value={price}
          onChange={(event) =>
            setPrice(event.target.valueAsNumber)
          }
          required
          aria-label="Hizmet fiyatı"
          className="rounded-xl border border-slate-600 bg-[#091322] p-3"
        />

        <button
          type="submit"
          disabled={saving || loading || !name.trim()}
          className="rounded-xl bg-blue-600 p-3 font-semibold disabled:opacity-50"
        >
          {saving
            ? "İşleniyor..."
            : editing
            ? "Değişiklikleri Kaydet"
            : "Hizmet Ekle"}
        </button>
      </form>

      {editing && (
        <button
          type="button"
          onClick={resetForm}
          className="text-sm text-cyan-400"
        >
          Düzenlemeyi iptal et
        </button>
      )}

      {error && (
        <p role="alert" className="text-sm text-red-400">
          {error}
        </p>
      )}

      {message && (
        <p role="status" className="text-sm text-emerald-400">
          {message}
        </p>
      )}

      <div className="flex items-center justify-between">
        <p className="text-sm text-emerald-400">
          Gerçek hizmet sayısı: {services.length}
        </p>

        <button
          type="button"
          disabled={loading || saving}
          onClick={() => {
            setLoading(true);
            refresh()
              .then(() => setError(""))
              .catch((err: unknown) =>
                setError(
                  err instanceof Error
                    ? err.message
                    : "Yenileme başarısız."
                )
              )
              .finally(() => setLoading(false));
          }}
          className="text-sm text-cyan-400 disabled:opacity-50"
        >
          Listeyi Yenile
        </button>
      </div>

      {loading ? (
        <p className="text-slate-400">Yükleniyor...</p>
      ) : filtered.length === 0 ? (
        <p className="text-sm text-slate-400">
          Bu sektörde henüz gerçek hizmet yok.
        </p>
      ) : (
        <div className="grid gap-3 md:grid-cols-2">
          {filtered.map((item) => (
  <div
    key={item.id}
    className="rounded-2xl border border-[#263b58] bg-[#101d30] p-5 transition hover:border-cyan-500/40"
  >
    <div className="flex items-start justify-between gap-3">
      <div className="flex items-center gap-3">
        <div className="rounded-xl bg-cyan-500/10 p-3 text-cyan-400">
          <BriefcaseBusiness size={22} />
        </div>

        <div>
          <h3 className="font-bold text-white">
            {item.name}
          </h3>
          <p className="mt-1 text-xs text-[#8299b7]">
            Hizmet ID: {item.id}
          </p>
        </div>
      </div>

      <span className="rounded-full bg-emerald-500/10 px-3 py-1 text-[11px] text-emerald-400">
        Veritabanı
      </span>
    </div>

    <div className="mt-5 grid grid-cols-2 gap-3">
      <div className="rounded-xl bg-[#0b1728] p-4">
        <div className="flex items-center gap-2 text-xs text-[#8ba4c2]">
          <Clock3 size={15} />
          Hizmet Süresi
        </div>

        <p className="mt-2 text-lg font-bold text-white">
          {item.durationMinutes} dk
        </p>
      </div>

      <div className="rounded-xl bg-[#0b1728] p-4">
        <p className="text-xs text-[#8ba4c2]">
          Hizmet Fiyatı
        </p>

        <p className="mt-2 text-lg font-bold text-cyan-400">
          {item.price.toLocaleString("tr-TR", {
            style: "currency",
            currency: "TRY",
          })}
        </p>
      </div>
    </div>

    <div className="mt-5 flex justify-end gap-2 border-t border-[#263b58] pt-4">
      <button
        type="button"
        disabled={saving}
        onClick={() => startEdit(item)}
        className="flex items-center gap-2 rounded-lg border border-[#355679] px-3 py-2 text-xs text-[#c4d8f0] hover:bg-[#1d3653] disabled:opacity-50"
      >
        <Pencil size={14} />
        Düzenle
      </button>

      <button
        type="button"
        disabled={saving}
        onClick={() => void remove(item)}
        className="flex items-center gap-2 rounded-lg border border-rose-500/20 px-3 py-2 text-xs text-rose-400 hover:bg-rose-500/10 disabled:opacity-50"
      >
        <Trash2 size={14} />
        Sil
      </button>
    </div>
  </div>
))}
        </div>
      )}
    </section>
  );
}